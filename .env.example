# Shopify app credentials (Dev Dashboard > your app > Settings)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://YOUR-APP-HOST
SCOPES=read_orders,read_files,write_app_proxy
# Postgres. DATABASE_URL may be a pooled connection, DIRECT_URL must be a direct or session connection (used by migrations)
DATABASE_URL=
DIRECT_URL=
# Optional: comma-separated myshopify domains that get Pro without billing (your own stores)
HOOKMATCH_PRO_SHOPS=
